# ── Graphify generated artifacts ──────────────────────────────────────────────
# Never commit — rebuilt on demand via /regraph
graphify-out/

# ── ML data — never commit raw or processed datasets ──────────────────────────
data/raw/
data/processed/

# Split files ARE committed (they define the experiment)
# data/splits/ is NOT ignored

# ── Model artifacts ────────────────────────────────────────────────────────────
# Checkpoints and exported models are large binary files
# Transfer to/from GPU server via scp or rsync, not git
checkpoints/
exported_models/

# MLflow local store — managed separately on GPU server
mlflow/mlflow.db
mlflow/artifacts/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.so
.eggs/

# ── Environments ──────────────────────────────────────────────────────────────
.env
.venv
env/
venv/
.conda/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Test artifacts ─────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Temp / scratch ─────────────────────────────────────────────────────────────
*.log
*.tmp
scratch/
